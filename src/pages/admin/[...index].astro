---
// src/pages/admin/[...index].astro
import { Studio } from 'sanity';
import config from '../../../sanity.config';

// ГАРАНТИРУЕМ, что эта страница будет собрана как статика, 
// даже если весь остальной сайт на сервере (SSR)
export const prerender = true;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>37.Eight Studio</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <Studio config={config} client:only="react" />
  </body>
</html>

<style is:global>
  html, body {
    height: 100vh;
    margin: 0;
    padding: 0;
    background-color: #f6f6f6;
  }
</style>
