---
// src/pages/admin/[...index].astro
import { Studio } from 'sanity';
import config from '../../../sanity.config'; // Путь из src/pages/admin/ в корень
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>37.Eight | Панель управления</title>
  </head>
  <body>
    <Studio config={config} client:only="react" />
  </body>
</html>

<style is:global>
  /* Сбрасываем все стили темы, чтобы админка была на весь экран */
  html,
  body {
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: #f6f6f6; /* Стандартный фон Sanity */
  }

  /* Исправляем возможные наложения от глобальных стилей темы */
  #sanity {
    height: 100vh;
  }
</style>
