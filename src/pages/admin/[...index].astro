---
// src/pages/admin/[...index].astro
import { Studio } from 'sanity';
import config from '../../../sanity.config';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>37.Eight | Admin Studio</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <Studio config={config} client:only="react" />
  </body>
</html>

<style is:global>
  /* Важно: сбрасываем стили темы Dyson, чтобы админка 
     занимала 100% экрана и выглядела чисто.
  */
  html,
  body {
    height: 100vh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #f6f6f6;
  }

  /* Если в теме Dyson есть глобальные отступы или 
     специфические шрифты для body, этот блок их нейтрализует внутри админки.
  */
  #sanity {
    height: 100vh;
  }
</style>
